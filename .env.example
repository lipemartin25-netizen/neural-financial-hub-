# Configurações do Ambiente — Neurafin Hub (Apenas referências, SEM segredos reais)

# API & Backend
ENVIRONMENT=development
API_PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de Dados (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neurafin_hub

# Armazenamento Privado (S3 / Local / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
STORAGE_BUCKET_NAME=neurafin-private-docs
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
