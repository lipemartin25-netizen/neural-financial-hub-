# ============================================================
# Neurafin Hub v3.0 — VARIÁVEIS DE AMBIENTE
# Copie para .env.local e preencha os valores reais
# NUNCA commitar .env.local ou .env.prod.local
# ============================================================

# ─── SUPABASE ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── GOOGLE GEMINI (IA Principal) ───────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ─── OPENAI (Fallback / Vision OCR) ─────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# ─── GOOGLE AUTH ────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ─── GITHUB AUTH (via Supabase OAuth) ───────────────────────
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

# ─── STRIPE ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Price IDs dos planos
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_FAMILY=price_xxx
STRIPE_PRICE_MEI=price_xxx

# ─── SEGURANÇA ───────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
ENCRYPTION_SECRET_KEY=
# Gerar com: openssl rand -hex 16
CSRF_SECRET=
CRON_SECRET=

# ─── OPEN FINANCE (Pluggy) ───────────────────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# ─── WEB PUSH / PWA (VAPID) ──────────────────────────────────
# Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contato@seudominio.com.br

# ─── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
NEXT_PUBLIC_APP_NAME=Neurafin Hub
NODE_ENV=production

# ─── BACKEND PYTHON (FastAPI) ────────────────────────────────
# Usado pelo services/api — pode ser .env separado em services/api/.env
PYTHON_API_URL=http://localhost:8000
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# Pasta para upload de documentos (OCR)
UPLOAD_DIR=./uploads
# Max tamanho de arquivo em MB
MAX_FILE_SIZE_MB=10
