# ==============================================================================
# NEURAFIN HUB — MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
#
# INSTRUÇÕES DE SEGURANÇA:
# 1. NUNCA versione credenciais ou arquivos '.env.local' no controle de versão Git.
# 2. Copie este arquivo para '.env.local' e informe os valores reais do seu ambiente.
# 3. Variáveis prefixadas com 'NEXT_PUBLIC_' são expostas ao navegador do cliente.
# 4. Variáveis sem esse prefixo são estritamente de servidor (Next.js / FastAPI).
# ==============================================================================

# ==============================================================================
# 1. FRONTEND WEB — NEXT.JS (PÚBLICAS / CLIENTE)
# ==============================================================================
NEXT_PUBLIC_APP_NAME="Neurafin Hub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth e Banco de Dados (Público)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto-placeholder.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_anon_key_ficticia"

# Stripe Checkout (Chave Publicável)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_chave_publica_ficticia"

# Push Notifications / PWA (Chave Pública VAPID)
# Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="placeholder_vapid_public_key"

# ==============================================================================
# 2. FRONTEND WEB — NEXT.JS (SEGREDOS DE SERVIDOR)
# ==============================================================================
# Supabase Service Role (Acesso com bypass de RLS — NUNCA expor no cliente)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_service_role_ficticia"

# Provedores de IA
GEMINI_API_KEY="AIzaSy_placeholder_chave_ficticia"
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY="sk-proj-placeholder_chave_ficticia"
OPENAI_MODEL="gpt-4o"

# OAuth Google (Servidor)
GOOGLE_CLIENT_ID="placeholder_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-placeholder_secret_ficticio"

# OAuth GitHub (via Supabase)
GITHUB_CLIENT_ID="placeholder_github_id"
GITHUB_CLIENT_SECRET="placeholder_github_secret"

# Stripe Pagamentos (Segredos de Servidor)
STRIPE_SECRET_KEY="sk_test_placeholder_chave_secreta_ficticia"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_ficticio"
STRIPE_PRICE_PRO="price_placeholder_pro"
STRIPE_PRICE_FAMILY="price_placeholder_family"
STRIPE_PRICE_MEI="price_placeholder_mei"

# Criptografia e Proteção de Sessão
# Gerar com: openssl rand -hex 32
ENCRYPTION_SECRET_KEY="placeholder_encryption_key_min_32_caracteres"
# Gerar com: openssl rand -hex 16
CSRF_SECRET="placeholder_csrf_secret_min_16_caracteres"
CRON_SECRET="placeholder_cron_secret"

# VAPID Privado
VAPID_PRIVATE_KEY="placeholder_vapid_private_key"
VAPID_EMAIL="mailto:seguranca@neurafin.com.br"

# ==============================================================================
# 3. BACKEND PYTHON — FASTAPI & PIPELINE WORKER (services/api & services/worker)
# ==============================================================================
ENVIRONMENT="development" # "development", "test" ou "production"
PYTHON_API_URL="http://localhost:8000"

# JWT Secret para assinatura e validação dos tokens
# OBRIGATÓRIO em produção (min 32 caracteres)
JWT_SECRET="placeholder_jwt_secret_min_32_caracteres_obrigatorio_em_producao"
JWT_ALGORITHM="HS256"

# Acesso ao Banco de Dados Supabase (PostgreSQL direto ou Service Key)
DATABASE_URL="postgresql://postgres:senha_placeholder@db.seu-projeto-placeholder.supabase.co:5432/postgres"
SUPABASE_URL="https://seu-projeto-placeholder.supabase.co"
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_service_role_ficticia"

# Armazenamento Seguro de Documentos (OCR e Extratores)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
